FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

RUN pip install uv

COPY pyproject.toml .

# Install only the runtime dependencies needed by the streaming workers.
RUN uv pip install --system \
    motor \
    pydantic \
    pydantic-settings \
    pymongo \
    quixstreams \
    websockets

COPY src/ ./src/
