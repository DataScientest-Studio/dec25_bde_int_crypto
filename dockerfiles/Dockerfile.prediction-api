FROM python:3.11-slim

WORKDIR /app

RUN pip install uv

COPY pyproject.toml .
RUN uv pip install --system \
    fastapi \
    uvicorn \
    pandas \
    numpy \
    scikit-learn \
    joblib \
    pydantic \
    pydantic-settings \
    python-multipart \
    pymongo \
    motor

COPY src/ ./src/

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]