FROM python:3.11-slim

WORKDIR /app

RUN pip install uv

COPY pyproject.toml .
RUN uv pip install --system \
    streamlit \
    requests \
    pandas \
    plotly

COPY src/ ./src/
COPY docs/ ./docs/
COPY assets/ ./assets/

CMD ["streamlit", "run", "src/dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0"]
