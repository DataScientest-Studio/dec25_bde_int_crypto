# Binance REST API Configuration
BINANCE_KLINES_URL=https://api.binance.com/api/v3/klines
BINANCE_MAX_LIMIT=1000
BINANCE_PAGE_SLEEP=0.25

# Data Collection Defaults
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=5m
BINANCE_START_DATE=2025-01-01
# BINANCE_END_DATE=

# Data Directory Layout
DATA_DIR=data
RAW_DATA_DIRNAME=raw_data
PROCESSED_DATA_DIRNAME=processed_data

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/
MONGODB_DATABASE=crypto_data
MONGODB_COLLECTION_HISTORICAL=klines_historical
MONGODB_COLLECTION_STREAMING=klines_streaming
